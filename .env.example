# Telegram bot token from @BotFather (free)
TELEGRAM_TOKEN=replace_me

# Google AI Studio API key (free tier, no card).
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me

# Which Gemini model to use for photo analysis.
# Flash = best quality/cost balance. Flash-Lite = even cheaper, slightly weaker.
GEMINI_MODEL=gemini-2.5-flash

# Food database enrichment via OpenFoodFacts (optional, free).
# If OFF is down/slow the bot still works using the AI estimates alone.
USE_OPENFOODFACTS=true
